<mxfile host="app.diagrams.net">
  <diagram id="kinesis-simple" name="Que es Kinesis">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;&amp;iquest;Qu&amp;eacute; hace Amazon Kinesis Data Streams?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Recibe un flujo continuo de eventos, los guarda en orden y permite que varias aplicaciones los lean&lt;/font&gt;" style="text;html=1;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="10" width="760" height="60" as="geometry"/>
        </mxCell>

        <!-- Cabeceras de columna -->
        <mxCell id="h1" value="&lt;b&gt;PRODUCTORES&lt;/b&gt;&lt;br&gt;quienes generan eventos" style="text;html=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="h3" value="&lt;b&gt;CONSUMIDORES&lt;/b&gt;&lt;br&gt;quienes leen y usan los eventos" style="text;html=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="960" y="90" width="230" height="40" as="geometry"/>
        </mxCell>

        <!-- Productores -->
        <mxCell id="p1" value="Aplicaci&amp;oacute;n web&lt;br&gt;(clics, compras)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="140" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="Sensores IoT&lt;br&gt;(temperatura, GPS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="240" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="Servidores&lt;br&gt;(logs, m&amp;eacute;tricas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="340" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- Stream -->
        <mxCell id="stream" value="&lt;b&gt;STREAM&lt;/b&gt; (el canal de Kinesis)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="330" y="90" width="440" height="340" as="geometry"/>
        </mxCell>

        <mxCell id="s0" value="Shard 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="350" y="145" width="90" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="Shard 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="350" y="245" width="90" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="Shard 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="350" y="345" width="90" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="a1" value="1" style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="470" y="155" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="a2" value="2" style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="520" y="155" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="a3" value="3" style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="570" y="155" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="a4" value="4" style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="620" y="155" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="a5" value="5" style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="670" y="155" width="40" height="40" as="geometry"/></mxCell>

        <mxCell id="b1" value="1" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="470" y="255" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="b2" value="2" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="520" y="255" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="b3" value="3" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="570" y="255" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="b4" value="4" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="620" y="255" width="40" height="40" as="geometry"/></mxCell>

        <mxCell id="c1" value="1" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="470" y="355" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="c2" value="2" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="520" y="355" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="c3" value="3" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="570" y="355" width="40" height="40" as="geometry"/></mxCell>

        <mxCell id="note1" value="Los eventos quedan en fila, en orden de llegada, dentro de cada shard (&amp;rarr;)" style="text;html=1;fontSize=11;fontStyle=2;align=center;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="450" y="205" width="290" height="30" as="geometry"/>
        </mxCell>

        <!-- Consumidores -->
        <mxCell id="k1" value="&lt;b&gt;Aplicaci&amp;oacute;n A&lt;/b&gt;&lt;br&gt;an&amp;aacute;lisis en tiempo real" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="980" y="140" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="k2" value="&lt;b&gt;Aplicaci&amp;oacute;n B&lt;/b&gt;&lt;br&gt;guardar historial (S3, BD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="980" y="240" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="k3" value="&lt;b&gt;Aplicaci&amp;oacute;n C&lt;/b&gt;&lt;br&gt;alertas y notificaciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="980" y="340" width="190" height="60" as="geometry"/>
        </mxCell>

        <!-- Flechas productores -> stream -->
        <mxCell id="e1" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="p1" target="stream"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="1. env&amp;iacute;an eventos" style="endArrow=classic;html=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="p2" target="stream"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="p3" target="stream"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Flechas stream -> consumidores -->
        <mxCell id="e4" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="stream" target="k1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="2. leen cada una a su ritmo" style="endArrow=classic;html=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="stream" target="k2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="stream" target="k3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Conceptos clave -->
        <mxCell id="t1" value="&lt;b&gt;Shard&lt;/b&gt;&lt;br&gt;Una &amp;quot;l&amp;iacute;nea&amp;quot; del stream. M&amp;aacute;s shards = m&amp;aacute;s capacidad y m&amp;aacute;s trabajo en paralelo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="270" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="&lt;b&gt;Clave de partici&amp;oacute;n&lt;/b&gt;&lt;br&gt;Decide a qu&amp;eacute; shard va cada evento. Misma clave = mismo shard = se mantiene el orden." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="470" width="270" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;Retenci&amp;oacute;n&lt;/b&gt;&lt;br&gt;Los eventos NO se borran al leerse: se guardan de 24 horas hasta 365 d&amp;iacute;as y se pueden releer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="470" width="270" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="t4" value="&lt;b&gt;Checkpoint&lt;/b&gt;&lt;br&gt;Cada consumidor anota hasta d&amp;oacute;nde ley&amp;oacute;. Si se cae, retoma desde ese punto." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="910" y="470" width="270" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="foot" value="&lt;b&gt;En una frase:&lt;/b&gt; Kinesis es un registro ordenado y persistente de eventos que muchos sistemas pueden leer de forma independiente." style="text;html=1;fontSize=13;align=center;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="150" y="600" width="900" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
